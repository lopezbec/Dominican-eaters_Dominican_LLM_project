# ==============================================================================
# Dominican Eaters Environment Configuration
# ==============================================================================
#
# Copy this file to .env and fill in your credentials
# cp .env.example .env
#
# IMPORTANT: Never commit .env to git (already in .gitignore)
#
# ==============================================================================

# ==============================================================================
# LYRICS EATER - Genius API
# ==============================================================================
# Required for fetching song lyrics from Genius
# Get your token at: https://genius.com/api-clients
# 1. Sign up/Login to Genius
# 2. Create new API Client
# 3. Copy the Client Access Token
#
GENIUS_TOKEN=your_genius_api_token_here

# ==============================================================================
# OPTIONAL - YouTube Data API (Not currently used)
# ==============================================================================
# The project uses yt-dlp and scrapetube which don't require API keys
# If you plan to use YouTube Data API v3, uncomment and configure:
#
# YOUTUBE_API_KEY=your_youtube_api_key_here
#
# Get your key at: https://console.cloud.google.com/apis/credentials

# ==============================================================================
# OPTIONAL - Logging Level
# ==============================================================================
# Uncomment to override default logging level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
#
# LOG_LEVEL=INFO

# ==============================================================================
# OPTIONAL - Custom Paths
# ==============================================================================
# Override default configuration file path
# CONFIG_PATH=audio_processing/config.yaml
