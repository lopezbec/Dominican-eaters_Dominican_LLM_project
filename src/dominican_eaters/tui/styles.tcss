$de-background: #0c0e0f;
$de-panel: #121516;
$de-panel-raised: #181c1d;
$de-line: #303637;
$de-muted: #899192;
$de-foreground: #e6e9e7;
$de-green: #77c38b;
$de-amber: #d6ad65;
$de-red: #e07373;

Screen { background: $de-background; color: $de-foreground; }

#topbar {
    height: 3;
    padding: 1 2 0 2;
    background: $de-panel;
    border-bottom: solid $de-line;
}
#brand { width: 22; color: $de-foreground; text-style: bold; }
#product { width: 1fr; color: $de-muted; }
#run-state { width: 13; text-align: right; color: $de-green; text-style: bold; }
#run-state.running { color: $de-amber; }

#workspace { height: 1fr; padding: 1; }
#control-panel {
    width: 40;
    min-width: 34;
    height: 100%;
    margin-right: 1;
    background: $de-panel;
    border: solid $de-line;
}
#form-scroll { height: 1fr; padding: 0 1; }
#command-dock {
    height: auto;
    min-height: 10;
    padding: 0 1 1 1;
    border-top: solid $de-line;
    background: $de-panel-raised;
}
.panel-title {
    height: 2;
    padding: 1 1 0 1;
    color: $de-muted;
    text-style: bold;
}
.field-label { margin-top: 1; color: $de-muted; }
.field { height: auto; margin-top: 1; }
.field Label { color: $de-muted; }
.field-row { height: auto; layout: horizontal; margin-top: 1; }
.field-row > .field { width: 1fr; margin: 0 1 0 0; }
Input, Select { border: tall $de-line; background: $de-background; }
Input:focus, Select:focus { border: tall $de-green; }
.options { height: auto; margin: 1 0; }
.options Checkbox { height: 2; }

#preview {
    height: auto;
    max-height: 4;
    padding: 0 1;
    color: #b7c1bd;
    background: $de-background;
    border-left: thick $de-green;
}
#status { height: 2; padding: 1 0 0 1; color: $de-green; }
#status.error { color: $de-red; }
#actions { height: 3; margin-top: 1; }
#actions Button { width: 1fr; min-width: 12; height: 3; margin-right: 1; }

#console-panel {
    width: 1fr;
    height: 100%;
    background: $de-panel;
    border: solid $de-line;
}
#console-header { height: 3; border-bottom: solid $de-line; }
#console-header .panel-title { width: 12; }
#console-hints {
    width: 1fr;
    padding: 1 1 0 0;
    text-align: right;
    color: $de-muted;
}
#output-log {
    height: 1fr;
    padding: 1 2;
    background: $de-background;
    color: $de-foreground;
    scrollbar-color: $de-line;
    scrollbar-color-hover: $de-muted;
    scrollbar-color-active: $de-green;
}
#output-log:focus { border-left: thick $de-green; }
#console-footer {
    height: 3;
    padding: 0 1;
    background: $de-panel-raised;
    border-top: solid $de-line;
    align-vertical: middle;
}
#output-label { width: 9; color: $de-green; text-style: bold; }
#output-state { width: 1fr; color: $de-muted; }
#clear { width: 10; height: 3; }

Footer { height: 1; background: $de-panel-raised; color: $de-muted; }
Screen.console-maximized #control-panel { display: none; }
Screen.console-maximized #workspace { padding: 0; }
Screen.console-maximized #console-panel { border: none; }
.hidden { display: none; }
